# ==============================================================================
# Máquina de Conteúdo — variáveis de ambiente (raiz, referência)
# Copia os blocos relevantes para apps/web/.env.local e apps/api/.env
# NUNCA commits valores reais. Segredos de produção vivem no Supabase Vault
# e nas variáveis do host da API.
# ==============================================================================

# --- Supabase (local: valores impressos por `supabase start`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Só na API (apps/api). NUNCA no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (Anthropic) — usado apenas pela API ---
ANTHROPIC_API_KEY=

# --- Fontes de notícias: feeds RSS configurados na tabela `sources`, sem chave
# de API nenhuma (ver docs/DATA_MODEL.md). Nada a preencher aqui.

# em dev sem acesso real ao site de origem: 'true' permite artigo-fonte mock
# (NUNCA em produção)
ALLOW_MOCK_FACTS=false

# --- Scheduler interno da API (apps/api), em minutos ---
TRENDS_SYNC_INTERVAL_MIN=10
GENERATE_POLL_INTERVAL_MIN=2
MAX_GENERATE_ATTEMPTS=3
