# Copia para deploy/deploy.env NA VPS. Nunca commitar o ficheiro real.
# Usado por deploy/deploy.sh e pelo systemd unit do webhook (deploy/webhook.service).

# Segredo partilhado com o webhook configurado nas definições do repositório
# GitHub (Settings -> Webhooks). Gera algo aleatório, ex.: `openssl rand -hex 32`.
WEBHOOK_SECRET=

# Supabase CLI (projeto de produção) — `supabase login` localmente para obter
# o access token; project ref e password da BD estão no dashboard do projeto.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
