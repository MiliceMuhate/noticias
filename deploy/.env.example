# Copia para deploy/.env NA VPS. Docker Compose lê este ficheiro automaticamente
# (mesma pasta do docker-compose.yml) para preencher os `args:` do build do web.
# Nunca commitar o ficheiro real.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADSENSE_CLIENT_ID=ca-pub-3729442721390367
VITE_GA_MEASUREMENT_ID=

# Runtime do web (não é build-arg): domínio público canónico, sem "/" final.
# Vai para <link rel="canonical">, og:url, JSON-LD e sitemap.xml.
SITE_URL=https://footballtrend.online

# Segredo partilhado entre a API e o contentor do Hermes (deploy/hermes/runner.py).
# Gera algo aleatório, ex.: `openssl rand -hex 32`. Não é a chave da IA do
# Hermes — essa muda-se no painel (/admin/hermes) e vive no Vault.
HERMES_RUNNER_TOKEN=
