# Web — copia para .env.local. O frontend SÓ conhece o URL e a chave anon.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Google AdSense (Auto ads, só no site público — ver src/lib/adsense.ts).
# Formato "ca-pub-xxxxxxxxxxxxxxxx", da tua conta AdSense. Deixa vazio até
# teres a conta aprovada — sem valor, o script simplesmente não carrega.
VITE_ADSENSE_CLIENT_ID=

# Google Analytics / Firebase (tráfego geral — origem, geografia, tempo real;
# só no site público — ver src/lib/analytics.ts). "Measurement ID" do teu
# stream de dados Web, formato "G-XXXXXXXXXX". Deixa vazio até criares o
# projeto Firebase — sem valor, o script simplesmente não carrega. As
# visualizações por artigo NÃO vêm daqui — isso é `content_items.view_count`
# no Supabase, mostrado na Fila de revisão.
VITE_GA_MEASUREMENT_ID=
