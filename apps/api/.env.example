# Copia para .env e preenche. Nunca commits valores reais (guardrail #4).

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# LLM via o proxy AWS empresarial (mesmo padrão dos projetos explicador/portifolio)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://aws-external-anthropic.us-east-2.api.aws
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-haiku-4-5

# Fontes de notícias: feeds RSS configurados na tabela `sources` (Config no painel),
# sem chave de API nenhuma.

# em dev sem acesso real ao site de origem: 'true' permite artigo-fonte mock
# (NUNCA em produção)
ALLOW_MOCK_FACTS=false

# cadência do scheduler interno, em minutos
TRENDS_SYNC_INTERVAL_MIN=10
GENERATE_POLL_INTERVAL_MIN=2
MAX_GENERATE_ATTEMPTS=3
